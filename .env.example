DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL for SQLite local development.
# DATABASE_URL=postgresql://creo:password@localhost:5432/creo
# CSRF_TRUSTED_ORIGINS=https://your-domain.replit.dev
# Optional. Use a Gemini project kept on the free tier, without paid billing.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=False
GEMINI_MODEL=gemini-3.5-flash-lite
# Production: set DEBUG=False, a unique secret, allowed hosts and HTTPS origins.
# PORT=3000
# MEDIA_ROOT=/persistent/media
# PRIVATE_MEDIA_ROOT=/persistent/private_media
# Enable only when your HTTPS proxy strips incoming X-Forwarded-Proto headers.
# TRUST_PROXY_HTTPS=True
# Waitress: exact IP of your HTTPS reverse proxy (not a hostname).
# TRUSTED_PROXY_IP=127.0.0.1
# SECURE_HSTS_SECONDS=3600
